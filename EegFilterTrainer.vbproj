<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>EegFilterTrainer</RootNamespace>
    <AssemblyName>EegFilterTrainer</AssemblyName>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <StartupObject>EegFilterTrainer.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <Product>EEG-Filter verstehen</Product>
    <Description>Interaktive Schulungsanwendung zu EEG-Filtern fuer MTA</Description>
    <Version>1.0.0</Version>
    <!-- erlaubt das Bauen auch auf Nicht-Windows-Systemen (z. B. CI); auf Windows ohne Wirkung -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
